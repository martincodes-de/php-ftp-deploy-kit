; Copy to deploy.ini (gitignored). Expected location: <project>/ftp-deployment/deploy.ini,
; with pfdk installed in <project>/ftp-deployment/ (see the README).
; Run everything from the project root, e.g.:
;   php ftp-deployment/vendor/bin/pfdk deploy -c ftp-deployment/deploy.ini
; ftps:// is FTP over TLS. ftp:// sends the password in clear text; use it only if the host offers nothing else.
remote = "ftps://USER:PASSWORD@HOST/REMOTE_PATH"
local = ..
allowDelete = yes

; pfdk runs build commands through DDEV when it is running; set to off to always use the host.
; pfdk_ddev = off

; @pfdk:settings

; Production secrets (APP_SECRET, API keys, ...) belong in <project>/.env.prod.local, which Symfony
; ignores in git (/.env.*.local) and this deploy uploads.
ignore = "
	.git*
	.idea
	.phpunit.result.cache
	/.ddev
	/tests
	/node_modules
	/var
	/ftp-deployment
	/.env.local
	/.env.dev
	/.env.test
	/Makefile
	/AGENTS.md
	/compose*.yaml
	/phpunit.dist.xml
	/phpstan.dist.neon
	*.log
"

; Your steps. `pfdk exec` runs a command in the project folder, through DDEV when it runs.
; @pfdk:before-build
; APP_ENV=prod is needed because Symfony's composer scripts would otherwise look for dev-only bundles.
before[] = "local: php ftp-deployment/vendor/bin/pfdk exec -c ftp-deployment/deploy.ini -- APP_ENV=prod composer install --no-dev --optimize-autoloader"
; Uncomment if the app uses AssetMapper: compiles the assets into public/assets.
; before[] = "local: php ftp-deployment/vendor/bin/pfdk exec -c ftp-deployment/deploy.ini -- APP_ENV=prod php bin/console asset-map:compile --no-interaction"
; Symfony reads APP_ENV from .env.local, which is not uploaded, so ship a prod flag instead.
before[] = "upload: ftp-deployment/env-prod-flag .env.local"

purge[] = "var/cache"

after[] = "local: php ftp-deployment/vendor/bin/pfdk exec -c ftp-deployment/deploy.ini -- composer install"
; Compiled assets must not stay locally, or the dev server would keep serving them.
after[] = "local: php ftp-deployment/vendor/bin/pfdk exec -c ftp-deployment/deploy.ini -- rm -rf public/assets"
