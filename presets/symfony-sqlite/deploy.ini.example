; Copy to deploy.ini (gitignored). Expected location: <project>/ftp-deployment/deploy.ini,
; with pfdk installed in <project>/ftp-deployment/ (see the README).
; Run everything from the project root, e.g.:
;   php ftp-deployment/vendor/bin/pfdk deploy -c ftp-deployment/deploy.ini
remote = "ftp://USER:PASSWORD@HOST/REMOTE_PATH"
local = ..
allowDelete = yes

pfdk_db = var/database.db
pfdk_backups = ftp-deployment/backups
pfdk_backups_keep = 10

; Opt in to `pfdk db:migrate` (pull the live DB, run the Doctrine migrations locally, push it back).
; pfdk_type = symfony
; pfdk_migrate_command = ddev exec php bin/console doctrine:migrations:migrate --no-interaction

ignore = "
	.git*
	.phpunit.result.cache
	/.ddev
	/tests
	/node_modules
	/var
	/ftp-deployment
	/.env.local
	/.env.test
	*.log
"

; Your steps. Prefix commands with `ddev` if you build inside DDEV.
; The backup comes first: the next step removes dev dependencies.
before[] = "local: php ftp-deployment/vendor/bin/pfdk backup -c ftp-deployment/deploy.ini"
; APP_ENV=prod is needed because Symfony's composer scripts would otherwise look for dev-only bundles.
before[] = "local: APP_ENV=prod composer install --no-dev --optimize-autoloader"
; Symfony reads APP_ENV from .env.local, which is not uploaded, so ship a prod flag instead.
before[] = "upload: ftp-deployment/env-prod-flag .env.local"

purge[] = "var/cache"

after[] = "local: composer install"
